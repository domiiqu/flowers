<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- the inhabitant's post, kept running by launchd. install:
         cp com.flowers.inhabitant-relay.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.flowers.inhabitant-relay.plist
       edit the two paths below first (node, and where this repo lives). -->
  <key>Label</key><string>com.flowers.inhabitant-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/flowers/tending/relay/mac-relay.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOU/flowers/tending/relay</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/inhabitant-relay.log</string>
  <key>StandardErrorPath</key><string>/tmp/inhabitant-relay.log</string>
</dict>
</plist>
